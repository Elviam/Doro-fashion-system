{
  "info": {
    "_postman_id": "78d25a24-a79f-4a31-a7e0-94f557230ba2",
    "name": "Doro QA",
    "description": "Colección QA reutilizable construida desde las rutas, esquemas, controladores y servicios actuales de D'oro. Use únicamente entornos locales o de prueba autorizados. La colección no contiene resultados históricos ni implica que las requests hayan sido ejecutadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Obtención y verificación de sesiones CLIENT y STAFF mediante endpoints reales de /api/auth.",
      "item": [
        {
          "name": "Client login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response contains a CLIENT token', () => {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.accountType).to.eql('CLIENT');",
                  "});",
                  "if (pm.response.code === 200 && typeof json.token === 'string') {",
                  "  pm.collectionVariables.set('client_token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Autentica una cuenta CLIENT por email. Si responde correctamente, guarda el JWT solo en la variable local client_token."
          }
        },
        {
          "name": "Other client login",
          "event": [
            {
