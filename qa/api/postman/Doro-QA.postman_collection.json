        {
          "name": "Verify client session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Current account is CLIENT', () => {",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.accountType).to.eql('CLIENT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/me",
            "description": "Verifica que client_token resuelva una sesión CLIENT activa."
          }
        },
