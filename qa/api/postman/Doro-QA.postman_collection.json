                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.accountType).to.eql('CLIENT');",
                  "});",
                  "if (pm.response.code === 200 && typeof json.token === 'string') {",
                  "  pm.collectionVariables.set('other_client_token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{other_client_email}}\",\n  \"password\": \"{{other_client_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Autentica una segunda cuenta CLIENT diferente y guarda el JWT solo en la variable local other_client_token."
          }
        },
